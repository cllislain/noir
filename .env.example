# Copy this file to .env and fill in real values
# Never commit .env to version control

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ENV=development

# ── PostgreSQL (local Docker development) ────────────────────────────────────
POSTGRES_DB=journal_db
POSTGRES_USER=journal_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Database URL (production — Supabase PostgreSQL) ───────────────────────────
# Used when DJANGO_SETTINGS_MODULE=config.settings.production
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── CSRF (production — add your Render URLs) ─────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com,https://your-frontend.onrender.com

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Auth throttle rate ────────────────────────────────────────────────────────
AUTH_THROTTLE_RATE=10/hour

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_BUCKET=noir_journal
SUPABASE_KEY=your-supabase-anon-or-service-key

# Supabase S3-compatible storage credentials
# Get from: Supabase Dashboard → Storage → S3 Access → Generate credentials
SUPABASE_S3_ACCESS_KEY_ID=your-supabase-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key
SUPABASE_S3_REGION=ap-southeast-1

# ── Production security ───────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set VITE_API_URL to your Render backend URL in production (leave unset for local dev)
VITE_API_URL=https://your-backend.onrender.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
